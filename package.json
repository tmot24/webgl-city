{
  "name": "webgl-city",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:angular": "npm run start -w @webgl-city/angular",
    "build:angular": "npm run build -w @webgl-city/angular",
    "start:react": "npm run start -w @webgl-city/react",
    "build:react": "npm run build -w @webgl-city/react",
    "typecheck:core": "npm run typecheck -w @webgl-city/core"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.3 || ^24.15.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
