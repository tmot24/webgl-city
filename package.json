{
  "name": "webgl-city",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:angular": "npm run start -w @webgl-city/angular",
